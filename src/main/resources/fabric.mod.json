{
  "schemaVersion": 1,
  "id": "simmc_tool_set",
  "version": "${version}",
  "name": "simMC 工具组",
  "description": "simMC client-side tools for Arcane HUD, scroll calculation, accessory loadouts, fermentation and cookware.",
  "authors": ["MurphyPotato"],
  "icon": "icon.png",
  "contact": {
    "homepage": "https://github.com/MurphyPotato/simmc-tool-set",
    "sources": "https://github.com/MurphyPotato/simmc-tool-set",
    "issues": "https://github.com/MurphyPotato/simmc-tool-set/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.murphypotato.simmctoolset.client.ToolSetClient"
    ],
    "modmenu": [
      "com.murphypotato.simmctoolset.client.ToolSetModMenuIntegration"
    ]
  },
  "mixins": [
    "simmc_tool_set.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11"
  },
  "suggests": {
    "modmenu": "*"
  }
}
