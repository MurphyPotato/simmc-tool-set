{
  "schemaVersion": 1,
  "id": "simmc_tool_set",
  "version": "${version}",
  "name": "simMC 工具组",
  "description": "simMC client-side tool set with optional Xaero map integration.",
  "authors": ["MurphyPotato"],
  "contact": {
    "homepage": "https://github.com/MurphyPotato/simmc-tool-set",
    "sources": "https://github.com/MurphyPotato/simmc-tool-set",
    "issues": "https://github.com/MurphyPotato/simmc-tool-set/issues"
  },
  "license": "MIT AND Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.murphypotato.simmctoolset.client.ToolSetClient"
    ],
    "modmenu": [
      "com.murphypotato.simmctoolset.internal.map.gui.SimmcMapModMenuIntegration"
    ]
  },
  "mixins": [
    "simmc_tool_set.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": ">=0.136.1+1.21.8"
  },
  "suggests": {
    "xaeroworldmap": "*",
    "xaerominimap": "*"
  }
}
